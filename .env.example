# Copy to .env and fill in real values. .env is gitignored; this file is the
# documentation of what the app needs. Never put real keys in here.

# Example — delete or replace with your own:
# DATABASE_URL=postgres://user:password@localhost:5432/app
# OPENAI_BASE_URL=https://ai.ohack.dev/v1      # OHack AI gateway (see your team card)
# OPENAI_API_KEY=sk-your-key                   # keep the real one in .env only

# Neon PostgreSQL connection string (server-side only)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require

# Exact browser application origin; required by protected JSON mutations.
APP_ORIGIN=https://localhost:3000

# Server-only MFA encryption key: base64 encoding of 32 cryptographically random bytes.
# Configure a stable value privately for persistent environments; never commit or log it.
# Synthetic demo mode generates an ephemeral in-memory key instead.
MFA_ENCRYPTION_KEY=

# Development seed opt-in. Production environment flags still block seeding.
ALLOW_SYNTHETIC_SEED=false

# Optional read-only Neon test (off by default).
RUN_NEON_TESTS=false
# Reporting API: server only. Generate a long random value in your deployment.
REPORTING_API_KEY=

# Local synthetic SQL demo only; production/Vercel refuses demo storage.
COLORLOOP_DEMO=false
# Set privately for local demo login (minimum 15 characters).
DEMO_PASSWORD=
LOCAL_TLS_KEY=node_modules/.cache/colorloop/tls.key
LOCAL_TLS_CERT=node_modules/.cache/colorloop/tls.crt

# Explicit operator bootstrap after reviewed migrations; never enable automatically.
BOOTSTRAP_ADMIN=false
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Explicit operator reconciliation of preserved historical references; never automatic.
RESOLVE_LEGACY_USERS=false
LEGACY_RESOLUTION_ACTOR_ID=

# Optional daily draft/task preparation; never sends messages.
# Set a random server-only secret of at least 32 characters and a real active account ID
# with tasks.manage and outreach.write. Leave unset to disable scheduled preparation.
CRON_SECRET=
AUTOMATION_USER_ID=

# Optional real Resend transport. Keep disabled until sender/test inbox verification.
# Local, demo and test-mode sends always require an exact verified-inbox allowlist.
EMAIL_DELIVERY_MODE=disabled
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEST_INBOXES=
# Live donor automation additionally requires CIC approval plus an audited admin policy.
CIC_DONOR_AUTOMATION_APPROVED=false
CIC_EMAIL_APPROVAL_REFERENCE=
